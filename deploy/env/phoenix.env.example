# Phoenix Authentication Configuration
# Enable authentication to require API keys for all interactions
PHOENIX_ENABLE_AUTH=true

# Phoenix Secret (minimum 32 characters, must include at least 1 digit and 1 lowercase letter)
# This is used to sign JWTs - CHANGE THIS TO A SECURE VALUE
PHOENIX_SECRET=9b51edd33957d65690ee1d11e38bd2ad6b9a8c89b9e4a7d69c9a59b7fcd29a5f

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

# Phoenix Client Configuration
PHOENIX_PROJECT=default
PHOENIX_COLLECTOR_ENDPOINT=http://phoenix:6006
# When using scripts/deploy/deploy_phoenix_ec2.sh, leave this placeholder so the script can auto-generate the key
PHOENIX_API_KEY=replace-with-phoenix-api-key

# Eval Runner Configuration
EVAL_PROVIDER=bedrock 
EVAL_MODEL=amazon.nova-lite-v1:0
BEDROCK_REGION=us-west-2
AWS_BEARER_TOKEN_BEDROCK='ABSKQmVkcm9ja0FQSUtleS12bnY1LWF0LTI4MDU2MDYwODg2NzpDL0FyQjNEamhhbVdWTGNhWUVaaE9pV0FsQ2xRTGJycVBIbTRFWWI1YTNrd05Yb1BKUEZLVWhEeUhVZz0='
EVAL_WINDOW_MINUTES=60
EVAL_INTERVAL_SECONDS=3500
# Set to "true" to enable
EVAL_SKIP_QA=false
EVAL_EXPLAIN=true

DIFY_API_KEY=app-lxtLIAa05Nl0Ndl7a7B3XdHv
# Use host.docker.internal to access DIFY running on host from Docker containers
# Change to http://dify:7788 if DIFY is also in docker-compose
DIFY_BASE_URL=https://dify.geoprofessional.org/v1

EVAL_PROVIDER=bedrock
EVAL_MODEL=us.amazon.nova-lite-v1:0
#EVAL_MODEL=gpt-4o
BEDROCK_REGION=us-west-2

