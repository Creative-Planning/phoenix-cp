# Phoenix deployment configuration (example)
#
# Copy this file to a safe location (e.g. deploy/phoenix.ec2.env or .env)
# and replace every placeholder value before running docker compose or the
# deployment script. Never commit the real secrets to git.

# ------------------------------------------------------------------------------
# Phoenix Authentication
# ------------------------------------------------------------------------------
PHOENIX_ENABLE_AUTH=true
PHOENIX_SECRET=replace-with-64-char-random-string
PHOENIX_ADMIN_SECRET=replace-with-different-64-char-admin-secret
PHOENIX_DEFAULT_ADMIN_INITIAL_PASSWORD=replace-with-strong-admin-password
PHOENIX_USE_SECURE_COOKIES=true
# If serving Phoenix behind HTTPS, list the trusted origins (comma separated)
# PHOENIX_CSRF_TRUSTED_ORIGINS=https://phoenix.your-domain.com

# ------------------------------------------------------------------------------
# Database (Postgres runs as a sidecar container)
# ------------------------------------------------------------------------------
POSTGRES_USER=phoenix
POSTGRES_PASSWORD=replace-with-strong-db-password
POSTGRES_DB=phoenix

# ------------------------------------------------------------------------------
# Phoenix project + API access
# ------------------------------------------------------------------------------
PHOENIX_PROJECT=default
PHOENIX_COLLECTOR_ENDPOINT=http://phoenix:6006
# API key generated from Phoenix UI (Settings → API Keys)
PHOENIX_API_KEY=replace-with-phoenix-api-key

# ------------------------------------------------------------------------------
# Evaluator / LLM credentials
# ------------------------------------------------------------------------------
OPENAI_API_KEY=replace-with-openai-or-compatible-key
EVAL_MODEL=gpt-4o
EVAL_WINDOW_MINUTES=60
EVAL_INTERVAL_SECONDS=3500
EVAL_SKIP_QA=false
EVAL_EXPLAIN=false

# ------------------------------------------------------------------------------
# Dify integration
# ------------------------------------------------------------------------------
DIFY_BASE_URL=https://dify.your-domain.com
DIFY_API_KEY=replace-with-dify-api-key

# ------------------------------------------------------------------------------
# Optional: customize Phoenix host path if running behind reverse proxy
# ------------------------------------------------------------------------------
# PHOENIX_HOST_ROOT_PATH=/phoenix
